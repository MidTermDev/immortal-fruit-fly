# deployer key (0x-prefixed). Receives the full $FLY supply at deploy; seed liquidity from it.
PRIVATE_KEY=0x
# https://docs.bnbchain.org/bnb-smart-chain/developers/rpc/
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# https://etherscan.io/apidashboard (Etherscan V2 key works for BscScan)
BSCSCAN_API_KEY=
# optional overrides
# TOKEN_NAME="Immortal Fruit Fly"
# TOKEN_SYMBOL=FLY
# TOKEN_SUPPLY=1000000000000000000000000000
# GENESIS_ENERGY=1000000
# TOKENS_PER_STEP=1000000000000000000
# STIM_PRICE=100000000000000000000
# RESURRECT_PRICE=100000000000000000000000
